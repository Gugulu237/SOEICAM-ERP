{
  "name": "Payment",
  "type": "object",
  "properties": {
    "payment_number": {
      "type": "string"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "customer_payment",
        "supplier_payment",
        "salary_payment"
      ]
    },
    "party_type": {
      "type": "string",
      "enum": [
        "customer",
        "supplier",
        "employee"
      ]
    },
    "party_id": {
      "type": "string"
    },
    "party_name": {
      "type": "string"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "bank_transfer",
        "mobile_money",
        "cheque"
      ],
      "default": "cash"
    },
    "reference": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "treasury_account_id": {
      "type": "string"
    },
    "treasury_account_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "rejected",
        "confirmed",
        "posted",
        "cancelled"
      ],
      "default": "draft"
    },
    "journal_id": {
      "type": "string"
    },
    "po_id": {
      "type": "string"
    },
    "prepared_by": {
      "type": "string"
    },
    "prepared_at": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    },
    "rejected_by": {
      "type": "string"
    },
    "rejected_at": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "disbursed_by": {
      "type": "string"
    },
    "disbursed_at": {
      "type": "string"
    },
    "cheque_gm_signed_by": {
      "type": "string"
    },
    "cheque_gm_signed_at": {
      "type": "string"
    },
    "cheque_pm_signed_by": {
      "type": "string"
    },
    "cheque_pm_signed_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "allocated_to_invoices": {
      "type": "string"
    }
  },
  "required": [
    "payment_type",
    "party_id",
    "amount",
    "payment_date"
  ]
}