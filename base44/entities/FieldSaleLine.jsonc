{
  "name": "FieldSaleLine",
  "type": "object",
  "properties": {
    "field_sale_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 0
    },
    "unit_price": {
      "type": "number",
      "default": 0
    },
    "list_price": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "line_total": {
      "type": "number",
      "default": 0
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    },
    "line_cost": {
      "type": "number",
      "default": 0
    },
    "lot_number": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    }
