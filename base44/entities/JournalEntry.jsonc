{
  "name": "JournalEntry",
  "type": "object",
  "properties": {
    "journal_number": {
      "type": "string"
    },
    "entry_date": {
      "type": "string",
      "format": "date"
    },
    "posting_date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "source_module": {
      "type": "string"
    },
    "source_document_type": {
      "type": "string"
    },
    "source_document_id": {
      "type": "string"
    },
    "posting_type": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "period_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "awaiting_review",
        "approved",
        "posted",
        "reversed",
        "rejected"
      ],
      "default": "draft"
    },
    "total_debit": {
      "type": "number",
      "default": 0
    },
    "total_credit": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "XAF"
    },
    "exchange_rate": {
      "type": "number",
      "default": 1
    },
    "created_by": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "posted_by": {
      "type": "string"
    },
    "posted_at": {
      "type": "string"
    },
    "reversal_of": {
      "type": "string"
    },
    "reversal_reason": {
      "type": "string"
    },
    "reversed_by_journal": {
      "type": "string"
    },
    "is_immutable": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "entry_date",
    "description"
  ]
}