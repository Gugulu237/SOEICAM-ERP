{
  "name": "StockBalance",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "warehouse_id": {
      "type": "string"
    },
    "warehouse_name": {
      "type": "string"
    },
    "lot_number": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "quantity": {
      "type": "number",
      "default": 0
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    },
    "total_value": {
      "type": "number",
      "default": 0
    },
    "qc_status": {
      "type": "string",
      "enum": [
        "approved",
        "quarantine",
        "rejected",
        "pending"
      ],
      "default": "approved"
    },
    "production_order_id": {
      "type": "string"
    },
    "qc_released_by": {
      "type": "string"
    },
    "qc_released_at": {
      "type": "string"
    },
    "qc_notes": {
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "warehouse_id"
  ]
}