{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "supplier_number": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "contact_person": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "tax_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "payment_terms_days": {
      "type": "number",
      "default": 30
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}