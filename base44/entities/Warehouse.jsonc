{
  "name": "Warehouse",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "warehouse_type": {
      "type": "string",
      "enum": [
        "raw_material",
        "packaging",
        "wip",
        "finished_goods",
        "cold_room",
        "quarantine",
        "damaged",
        "vehicle",
        "general",
        "commercial_custody",
        "field_delivery_pending"
      ]
    },
    "custodian_employee_id": {
      "type": "string"
    },
    "custodian_name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "code",
    "warehouse_type"
  ]
}