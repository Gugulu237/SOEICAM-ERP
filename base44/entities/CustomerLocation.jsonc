{
  "name": "CustomerLocation",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "is_headquarters": {
      "type": "boolean",
      "default": false
    },
    "contact_person": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "town": {
      "type": "string"
    },
    "neighbourhood": {
      "type": "string"
    },
    "gps_lat": {
      "type": "number"
    },
    "gps_lng": {
      "type": "number"
    },
    "gps_accuracy_m": {
      "type": "number"
    },
    "gps_captured_at": {
      "type": "string"
    },
    "delivery_instructions": {
      "type": "string"
    },
    "assigned_commercial_id": {
      "type": "string"
    },
    "assigned_commercial_name": {
      "type": "string"
    },
    "assigned_hotesse_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "route_id": {
      "type": "string"
    },
    "route_name": {
      "type": "string"
    },
    "delivery_days": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "name"
  ]
}