{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "ticket_number": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "complaint",
        "order_request",
        "billing",
        "delivery",
        "product_quality",
        "other"
      ],
      "default": "other"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "assigned_to": {
      "type": "string"
    },
    "response": {
      "type": "string"
    },
    "responded_at": {
      "type": "string"
    },
    "responded_by": {
      "type": "string"
    },
    "created_via_portal": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "customer_id",
    "subject",
    "category"
  ]
}