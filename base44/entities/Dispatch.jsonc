{
  "name": "Dispatch",
  "type": "object",
  "properties": {
    "dispatch_number": {
      "type": "string"
    },
    "dispatch_date": {
      "type": "string",
      "format": "date"
    },
    "route_id": {
      "type": "string"
    },
    "route_name": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "vehicle_warehouse_id": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "salesperson_id": {
      "type": "string"
    },
    "salesperson_name": {
      "type": "string"
    },
    "warehouse_id": {
      "type": "string"
    },
    "warehouse_name": {
      "type": "string"
    },
    "departure_date": {
      "type": "string"
    },
    "return_date": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "loaded",
        "in_transit",
        "returned",
        "completed",
        "cancelled"
      ],
      "default": "draft"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    },
    "loaded_by": {
      "type": "string"
    },
    "loaded_at": {
      "type": "string"
    },
    "closed_by": {
      "type": "string"
    },
    "closed_at": {
      "type": "string"
    },
    "total_loaded_value": {
      "type": "number",
      "default": 0
    },
    "total_delivered_value": {
      "type": "number",
      "default": 0
    },
    "total_returned_value": {
      "type": "number",
      "default": 0
    },
    "total_cash_collected": {
      "type": "number",
      "default": 0
    },
    "total_credit_sales": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "dispatch_date",
    "vehicle_id"
  ]
}