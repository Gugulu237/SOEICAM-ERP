{
  "name": "StockMovement",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "movement_type": {
      "type": "string",
      "enum": [
        "purchase_receipt",
        "supplier_return",
        "production_issue",
        "production_return",
        "production_consumption",
        "production_output",
        "warehouse_transfer",
        "vehicle_load",
        "customer_delivery",
        "customer_return",
        "damage",
        "expiry",
        "quality_quarantine",
        "quality_release",
        "stock_adjustment",
        "stock_count_variance",
        "promotional_issue",
        "sample_issue"
      ]
    },
    "source_warehouse_id": {
      "type": "string"
    },
    "destination_warehouse_id": {
      "type": "string"
    },
    "lot_number": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    },
    "total_value": {
      "type": "number",
      "default": 0
    },
    "document_type": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "reversed"
      ],
      "default": "approved"
    },
    "movement_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "product_id",
    "quantity",
    "movement_type"
  ]
}