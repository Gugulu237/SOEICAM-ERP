{
  "name": "Customer",
  "type": "object",
  "properties": {
    "customer_number": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "parent_id": {
      "type": "string"
    },
    "parent_name": {
      "type": "string"
    },
    "contact_person": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "tax_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "supermarket",
        "minimarket",
        "wholesaler",
        "shop",
        "cash_customer",
        "institutional"
      ],
      "default": "shop"
    },
    "financial_centralization_mode": {
      "type": "string",
      "enum": [
        "centralized",
        "decentralized"
      ],
      "default": "centralized"
    },
    "address": {
      "type": "string"
    },
    "town": {
      "type": "string"
    },
    "neighbourhood": {
      "type": "string"
    },
    "gps_lat": {
      "type": "number"
    },
    "gps_lng": {
      "type": "number"
    },
    "gps_accuracy_m": {
      "type": "number"
    },
    "gps_captured_at": {
      "type": "string"
    },
    "delivery_instructions": {
      "type": "string"
    },
    "salesperson_id": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "delivery_days": {
      "type": "string"
    },
    "credit_limit": {
      "type": "number",
      "default": 0
    },
    "max_overdue_days": {
      "type": "number",
      "default": 30
    },
    "payment_terms_days": {
      "type": "number",
      "default": 0
    },
    "price_list": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "credit_status": {
      "type": "string",
      "enum": [
        "good",
        "warning",
        "hold",
        "blocked"
      ],
      "default": "good"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "acquired_by_id": {
      "type": "string"
    },
    "acquired_by_name": {
      "type": "string"
    },
    "acquisition_date": {
      "type": "string",
      "format": "date"
    },
    "acquisition_source": {
      "type": "string"
    },
    "acquisition_verified": {
      "type": "string",
      "enum": [
        "pending",
        "verified_unique",
        "duplicate",
        "rejected"
      ],
      "default": "pending"
    },
    "acquisition_verified_by": {
      "type": "string"
    },
    "acquisition_verified_at": {
      "type": "string"
    },
    "acquisition_notes": {
      "type": "string"
    },
    "registered_by_id": {
      "type": "string"
    },
    "registered_at": {
      "type": "string"
    }
  },
  "required": [
    "business_name"
  ]
}