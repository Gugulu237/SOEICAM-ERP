{
  "name": "PurchaseItem",
  "type": "object",
  "properties": {
    "item_code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "petty",
        "machinery_asset",
        "office_supply",
        "service"
      ]
    },
    "category_label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "estimated_cost": {
      "type": "number",
      "default": 0
    },
    "default_supplier_id": {
      "type": "string"
    },
    "default_supplier_name": {
      "type": "string"
    },
    "default_account_id": {
      "type": "string"
    },
    "default_account_number": {
      "type": "string"
    },
    "default_account_name": {
      "type": "string"
    },
    "is_asset": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "category"
  ]
}