# Set the actual production HTTPS URL in Hostinger; keep localhost for local use.
NEXT_PUBLIC_APP_URL=http://localhost:5174
NEXT_PUBLIC_AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
DATABASE_SSL=require
# Set these when the configured sign-in provider is Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_TELEMETRY_DISABLED=1

# Optional Google map provider. OpenStreetMap works when these are blank.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
