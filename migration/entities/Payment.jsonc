{
  "name": "Payment",
  "type": "object",
  "properties": {
    "payment_number": {
      "type": "string"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "customer_payment",
        "supplier_payment",
        "salary_payment"
      ]
    },
    "party_type": {
      "type": "string",
      "enum": [
        "customer",
        "supplier",
        "employee"
      ]
    },
    "party_id": {
      "type": "string"
    },
    "party_name": {
      "type": "string"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "bank_transfer",
        "mobile_money",
        "cheque"
      ],
      "default": "cash"
    },
    "reference": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "treasury_account_id": {
      "type": "string"
    },
    "treasury_account_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "rejected",
        "confirmed",
        "posted",
        "cancelled"
      ],
      "default": "draft"
    },
    "journal_id": {
      "type": "string"
    },
    "po_id": {
      "type": "string"
    },
    "prepared_by": {
      "type": "string"
    },
    "prepared_at": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    },
    "rejected_by": {
      "type": "string"
    },
    "rejected_at": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "disbursed_by": {
      "type": "string"
    },
    "disbursed_at": {
      "type": "string"
    },
    "cheque_gm_signed_by": {
      "type": "string"
    },
    "cheque_gm_signed_at": {
      "type": "string"
    },
    "cheque_pm_signed_by": {
      "type": "string"
    },
    "cheque_pm_signed_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "allocated_to_invoices": {
      "type": "string"
    },
    "invoice_numbers": {
      "type": "string"
    },
    "cashier_confirmed_by": {
      "type": "string"
    },
    "cashier_confirmed_name": {
      "type": "string"
    },
    "cashier_confirmed_at": {
      "type": "string"
    },
    "collection_id": {
      "type": "string"
    },
    "receipt_request_key": {
      "type": "string"
    },
    "receipt_posting_token": {
      "type": "string",
      "default": ""
    },
    "receipt_posting_error": {
      "type": "string"
    },
    "receipt_posting_snapshot": {
      "type": "object",
      "additionalProperties": true
    },
    "receipt_allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "invoice_id": {
            "type": "string"
          },
          "invoice_number": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        },
        "required": [
          "invoice_id",
          "amount"
        ]
      }
    }
  },
  "required": [
    "payment_type",
    "party_id",
    "amount",
    "payment_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.payment_type": {
            "$ne": "customer_payment"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.payment_type": {
            "$ne": "customer_payment"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.payment_type": {
            "$ne": "customer_payment"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}