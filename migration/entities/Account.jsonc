{
  "name": "Account",
  "type": "object",
  "properties": {
    "account_number": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "asset",
        "liability",
        "equity",
        "revenue",
        "cogs",
        "expense",
        "other_income",
        "other_expense"
      ]
    },
    "subtype": {
      "type": "string"
    },
    "financial_statement": {
      "type": "string",
      "enum": [
        "balance_sheet",
        "income_statement"
      ]
    },
    "cash_flow_category": {
      "type": "string",
      "enum": [
        "operating",
        "investing",
        "financing",
        "none"
      ],
      "default": "none"
    },
    "parent_id": {
      "type": "string"
    },
    "normal_balance": {
      "type": "string",
      "enum": [
        "debit",
        "credit"
      ]
    },
    "is_posting": {
      "type": "boolean",
      "default": true
    },
    "is_control_account": {
      "type": "boolean",
      "default": false
    },
    "allow_manual_journal": {
      "type": "boolean",
      "default": true
    },
    "is_treasury": {
      "type": "boolean",
      "default": false
    },
    "reconciliation_required": {
      "type": "boolean",
      "default": false
    },
    "branch_restriction": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "XAF"
    },
    "currency_restriction": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_system": {
      "type": "boolean",
      "default": false
    },
    "is_sample": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "account_number",
    "name",
    "account_type",
    "normal_balance"
  ]
}