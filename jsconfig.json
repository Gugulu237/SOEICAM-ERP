{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "jsx": "preserve",
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "resolveJsonModule": true
  },
  "exclude": [
    "node_modules",
    "migration/legacy",
    "base44",
    ".next"
  ]
}
